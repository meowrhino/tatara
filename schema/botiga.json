{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/botiga.json: la botiga",
  "description": "data/botiga.json: els productes. Les unitats (stock) no van aquí: es porten a admin/stock.html. VS Code llegeix aquest fitxer (pel \"$schema\" de dalt del JSON) per completar, explicar cada camp i subratllar el que està malament; npm run check (i la publicació) el fa servir per revisar.",
  "type": "object",
  "required": [
    "currency",
    "products"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "description": "Una nota (\"_comment\", \"_nota\"…): no surt a la web."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "description": "El símbol de la moneda: \"€\""
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Un nom curt i únic. Lliga el producte amb el seu stock: no es canvia."
          },
          "title": {
            "$ref": "#/$defs/text",
            "description": "El títol."
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Qui l'ha fet, o null."
          },
          "editorial": {
            "type": [
              "string",
              "null"
            ],
            "description": "L'editorial, o null."
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "description": "El preu en euros, sense cometes: 18. Sense preu, surt \"pròximament\"."
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/foto"
            },
            "description": "Les fotos, amb la carpeta: [\"assets/img/edicions/nom.webp\"]"
          },
          "description": {
            "$ref": "#/$defs/text",
            "description": "Opcional: el text."
          },
          "activo": {
            "type": "boolean",
            "description": "Opcional: false per amagar-lo de la botiga."
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "description": "En els tres idiomes: { \"ca\": \"…\", \"es\": \"…\", \"en\": \"…\" }",
      "properties": {
        "ca": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "AAAA-MM-DD: \"2027-03-01\""
    },
    "foto": {
      "type": "string",
      "pattern": "^assets/img/.+\\.(webp|jpg|jpeg|png|svg)$",
      "description": "La foto, amb la carpeta: \"assets/img/agenda/nom.webp\""
    }
  }
}
