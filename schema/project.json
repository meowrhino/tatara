{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/exposicions/<slug>/project.json: una exposició",
  "description": "data/exposicions/<slug>/project.json: la fitxa d'una exposició. Les fotos, a img/ de la mateixa carpeta; el full de sala (PDF), al costat. VS Code llegeix aquest fitxer (pel \"$schema\" de dalt del JSON) per completar, explicar cada camp i subratllar el que està malament; npm run check (i la publicació) el fa servir per revisar.",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "description": "Una nota (\"_comment\", \"_nota\"…): no surt a la web."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Qui: \"Anna Dot\""
    },
    "expo": {
      "$ref": "#/$defs/text",
      "description": "El títol de l'exposició."
    },
    "date": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/data"
        },
        "end": {
          "$ref": "#/$defs/data"
        }
      },
      "description": "Les dates: { \"start\": \"2026-01-15\", \"end\": \"2026-02-28\" }"
    },
    "text": {
      "$ref": "#/$defs/text",
      "description": "El text de l'exposició."
    },
    "bio": {
      "$ref": "#/$defs/text",
      "description": "La bio de l'artista."
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "El número, entre cometes i sense .webp: \"3\""
      },
      "description": "Les fotos de img/, en ordre: [\"1\", \"2\", \"3\"]"
    },
    "pdf": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      ],
      "description": "Opcional: el full de sala, \"full-de-sala.pdf\" (a la carpeta), o { \"url\": \"…\", \"label\": \"…\" }, o una llista."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Opcional: la web de l'artista, \"https://…\""
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "description": "En els tres idiomes: { \"ca\": \"…\", \"es\": \"…\", \"en\": \"…\" }",
      "properties": {
        "ca": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "AAAA-MM-DD: \"2027-03-01\""
    },
    "foto": {
      "type": "string",
      "pattern": "^assets/img/.+\\.(webp|jpg|jpeg|png|svg)$",
      "description": "La foto, amb la carpeta: \"assets/img/agenda/nom.webp\""
    }
  }
}
