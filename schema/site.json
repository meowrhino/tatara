{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/site.json: el general de la web",
  "description": "data/site.json: el nom, els idiomes, els colors, el contacte i el menú. VS Code llegeix aquest fitxer (pel \"$schema\" de dalt del JSON) per completar, explicar cada camp i subratllar el que està malament; npm run check (i la publicació) el fa servir per revisar.",
  "type": "object",
  "required": [
    "url",
    "site",
    "languages",
    "defaultLang",
    "theme",
    "contact",
    "menu"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^_": {
      "description": "Una nota (\"_comment\", \"_nota\"…): no surt a la web."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^/]+$",
      "description": "El domini de la web, sense barra al final: \"https://tatara.cat\". La publicació el fa servir per a les adreces que surten a Google i en compartir."
    },
    "site": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "El nom: \"TAT ARA\""
        },
        "studio": {
          "type": "string"
        },
        "tagline": {
          "$ref": "#/$defs/text",
          "description": "La frase sota el nom, i a Google."
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "ca",
          "es",
          "en"
        ]
      },
      "description": "Els idiomes de la web: [\"ca\", \"es\", \"en\"]"
    },
    "defaultLang": {
      "enum": [
        "ca",
        "es",
        "en"
      ],
      "description": "L'idioma de les adreces sense /es/ ni /en/."
    },
    "theme": {
      "type": "object",
      "description": "Els colors de la web (#ffffff o rgba(…)). Cada un es fa servir com a --nom al CSS.",
      "patternProperties": {
        "^_": {
          "description": "Una nota (\"_comment\", \"_nota\"…): no surt a la web."
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "contact": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "$ref": "#/$defs/text",
          "description": "El text de la pàgina de contacte."
        },
        "address": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "L'adreça, una línia per element."
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "description": "El correu de contacte."
        },
        "links": {
          "type": "array",
          "description": "Els enllaços del peu de contacte, en ordre.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "\"https://…\" (una altra web), \"#newsletter\" (una secció d'aquí) o null (encara sense enllaç)."
              }
            }
          }
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Una nota (\"_comment\", \"_nota\"…): no surt a la web."
        }
      }
    },
    "menu": {
      "type": "array",
      "description": "Les seccions, en l'ordre del menú. L'id i el type no es toquen; el label és el nom al menú.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "L'adreça de la secció. No es toca."
          },
          "type": {
            "enum": [
              "agenda",
              "text",
              "people",
              "shop",
              "contact",
              "newsletter",
              "cart"
            ],
            "description": "Com es pinta. No es toca."
          },
          "data": {
            "type": "string",
            "pattern": "^data/[a-z0-9-]+\\.json$",
            "description": "El JSON de la secció: \"data/agenda.json\""
          },
          "label": {
            "$ref": "#/$defs/text",
            "description": "El nom al menú, en els tres idiomes."
          },
          "hidden": {
            "type": "boolean",
            "description": "true: la secció existeix però no surt al menú (el carret)."
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "description": "En els tres idiomes: { \"ca\": \"…\", \"es\": \"…\", \"en\": \"…\" }",
      "properties": {
        "ca": {
          "type": "string"
        },
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "AAAA-MM-DD: \"2027-03-01\""
    },
    "foto": {
      "type": "string",
      "pattern": "^assets/img/.+\\.(webp|jpg|jpeg|png|svg)$",
      "description": "La foto, amb la carpeta: \"assets/img/agenda/nom.webp\""
    }
  }
}
