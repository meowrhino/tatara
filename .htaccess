# .htaccess de la raíz (Apache, Pangea).

DirectoryIndex index.html

# Cada sección tiene su dirección (/nosaltres/, /exposicions/anna-dot/…) y al
# publicar se genera su index.html ya pintado (tools/prerender.mjs). Una
# dirección que no existe contesta 404 (para Google, si no, existiría) con el
# index.html de la raíz, que pinta la agenda: quien llega ahí ve la web igual.
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Los fulls de sala vivían en /assets/pdf/ hasta el 2026-10-15; ahora, en la
  # carpeta de cada exposición (data/exposicions/<slug>/). Por si alguien guardó
  # o compartió el enlace viejo.
  RewriteRule ^assets/pdf/ariadna-serrahima-cataleg\.pdf$ /data/exposicions/ariadna-serrahima/ariadna-serrahima-cataleg.pdf [R=301,L]
  RewriteRule ^assets/pdf/emma-prats-full-de-sala\.pdf$ /data/exposicions/emma-prats/emma-prats-full-de-sala.pdf [R=301,L]
  RewriteRule ^assets/pdf/no-limits-full-de-sala\.pdf$ /data/exposicions/joana-mallol-olatz-azcona-i-sara-g-de-ubieta/no-limits-full-de-sala.pdf [R=301,L]
  RewriteRule ^assets/pdf/maria-roy-full-de-sala\.pdf$ /data/exposicions/maria-roy-deulofeu/maria-roy-full-de-sala.pdf [R=301,L]
  RewriteRule ^assets/pdf/solange-full-de-sala\.pdf$ /data/exposicions/solange-dalannais/solange-full-de-sala.pdf [R=301,L]
  RewriteRule ^assets/pdf/tasio-ranz-full-de-sala\.pdf$ /data/exposicions/tasio-ranz/tasio-ranz-full-de-sala.pdf [R=301,L]

  # Por si alguna vez se sube el repo entero: lo que no es web, no se sirve.
  RewriteRule ^(src|tools|migrations|node_modules|\.wrangler)/ - [F,L]
  RewriteRule \.(sql|toml|md)$ - [F,L]

  # El carret no se pre-renderiza (no es para Google), pero existe: ahí vuelve
  # Stripe después de pagar (/carret/?gracies=1).
  RewriteRule ^((es|en)/)?carret/?$ index.html [L]
</IfModule>

<FilesMatch "^\.(dev\.vars|env|gitignore|assetsignore)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# El contenido que la clienta edita (JSON) y el código de la web (HTML/CSS/JS)
# se revalidan en cada visita: subir un fichero por SFTP y verlo ya cambiado.
# Las fotos y las tipografías, cuando cambian, cambian de nombre: caché larga.
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|avif|woff2?|ttf|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
