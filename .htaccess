# .htaccess de la raíz (Apache, Pangea).

DirectoryIndex index.html

# Cada sección tiene su dirección (/nosaltres/, /exposicions/anna-dot/…) y al
# publicar se genera su index.html ya pintado (tools/prerender.mjs). Si una
# dirección no tiene fichero, se sirve el index.html de la raíz y el JS pinta
# la sección: así nada da 404 aunque el pre-render no se haya hecho.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Por si alguna vez se sube el repo entero: lo que no es web, no se sirve.
  RewriteRule ^(src|tools|migrations|node_modules|\.wrangler)/ - [F,L]
  RewriteRule \.(sql|toml|md)$ - [F,L]

  RewriteCond %{REQUEST_URI} !^/(api|admin)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^\.(dev\.vars|env|gitignore|assetsignore)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# El contenido que la clienta edita (JSON) y el código de la web (HTML/CSS/JS)
# se revalidan en cada visita: subir un fichero por SFTP y verlo ya cambiado.
# Las fotos y las tipografías, cuando cambian, cambian de nombre: caché larga.
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|avif|woff2?|ttf|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

AddDefaultCharset UTF-8
